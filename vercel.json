{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/static/:path*" },
    { "source": "/", "destination": "/static/index.html" }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{.venv/**,reports/**,docs/**,leads.sqlite3,static/**}"
    }
  }
}
